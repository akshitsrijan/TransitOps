# =========================================
# TransitOps Backend - Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file.
# =========================================

# --- App ---
APP_NAME=TransitOps
APP_ENV=development          # development | staging | production
DEBUG=True
API_V1_PREFIX=/api/v1

# --- Database (MySQL 8) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=transitops_user
DB_PASSWORD=change_me
DB_NAME=transitops_db

# Optional: full DSN override (if set, takes priority over the fields above)
# DATABASE_URL=mysql+pymysql://transitops_user:change_me@localhost:3306/transitops_db

# --- SQLAlchemy Engine Tuning ---
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=False

# --- Security ---
SECRET_KEY=replace_with_a_long_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
